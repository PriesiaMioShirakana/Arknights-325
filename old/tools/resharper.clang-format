# Explicit command-line approximation of docs/resharper-formatting.json.
# This filename is intentionally not auto-discovered by editors. ReSharper remains authoritative.
# Requires clang-format 22+. See docs/formatting.md for differences.
Language: Cpp
BasedOnStyle: LLVM
UseTab: Always
IndentWidth: 4
TabWidth: 4
ColumnLimit: 120
ContinuationIndentWidth: 4
AccessModifierOffset: -4
NamespaceIndentation: All
IndentExternBlock: NoIndent
IndentCaseLabels: false
IndentCaseBlocks: true
IndentGotoLabels: true
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignOperands: DontAlign
AlignTrailingComments: {Kind: Never}
AlignAfterOpenBracket: true
BinPackArguments: false
BinPackParameters: OnePerLine
BinPackLongBracedList: false
BreakAfterOpenBracketFunction: true
BreakBeforeCloseBracketFunction: true
BreakAfterOpenBracketBracedList: true
BreakBeforeCloseBracketBracedList: true
PackConstructorInitializers: CurrentLine
BreakConstructorInitializers: BeforeColon
BreakInheritanceList: BeforeColon
BreakTemplateDeclarations: Yes
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  BeforeWhile: true
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false
AllowShortBlocksOnASingleLine: Always
AllowShortFunctionsOnASingleLine: All
AllowShortLambdasOnASingleLine: All
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
AllowShortLoopsOnASingleLine: true
AllowShortEnumsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: true
PointerAlignment: Left
ReferenceAlignment: Left
SpaceInEmptyBraces: Block
SpaceBeforeParens: ControlStatements
SpacesInParens: Never
SpacesInAngles: Never
SeparateDefinitionBlocks: Leave
MaxEmptyLinesToKeep: 2
EmptyLineBeforeAccessModifier: Always
EmptyLineAfterAccessModifier: Never
FixNamespaceComments: false
InsertNewlineAtEOF: false
